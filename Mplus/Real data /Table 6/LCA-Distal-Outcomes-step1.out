Mplus VERSION 9.1
MUTHEN & MUTHEN
06/17/2026   6:35 PM

INPUT INSTRUCTIONS

  TITLE: Model with Distal Outcomes
         Application - Analysis of Data from PrEP1519 Study (Brazil)
         Objective -  Fixing the thresholds and compute measurement error. 
         Reproduces the results presented in Table 6 of the manuscript (BCH)
         Amorim, Arrais et al (2026)
         (Based on Muthen/Asparouhov 
          Nylund-Gibson e Choi Appendix - Step 1


   DATA:	
     file is PrEPdata-distal.txt;

  VARIABLE:	
     NAMES are  id prep age race educ
                hivrisk  pep lubrif testhiv 
                penet condom;
     USEVAR ARE pep lubrif testhiv 
                penet condom;
     CLASSES = c (2);
     CATEGORICAL = pep lubrif testhiv 
                penet condom;
     AUXILIARY = id prep age race educ
                 hivrisk ;
     MISSING = ALL (9999);


ANALYSIS: TYPE = MIXTURE;
          STARTS = 100 100;  

MODEL:
    %OVERALL%
    ! using start values to speed up
    ! estimation 
	! item thresholds by class

      %c#1%
       [pep$1*2.008 lubrif$1*0.604 testhiv$1*15.000
        penet$1*2.352  condom$1*15.000];

  
    %c#2%
       [pep$1*2.090 lubrif$1*-1.230 testhiv$1*2.060
        penet$1*1.442 condom$1*-0.041];

SAVEDATA: FILE = PrEPdata-3STEP.dat;
          SAVE = cprob;



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!  Selected output excerpts (.out) reproducing Table 6
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!



